# /etc/systemd/system/lu-node.service
# Instalar:  sudo cp deploy/lu-node.service /etc/systemd/system/ && sudo systemctl daemon-reload
#            sudo systemctl enable --now lu-node
# Logs:      journalctl -u lu-node -f
[Unit]
Description=lu-node - libro unificado (Binance spot + USDⓈ-M)
Wants=network-online.target chronyd.service
After=network-online.target chronyd.service

[Service]
Type=simple
User=lu
Group=lu
ExecStart=/opt/lu/lu-node --symbol SOLUSDT --markets spot,perp --lines 2 --listen 127.0.0.1:9100 --pin
Restart=always
RestartSec=2
# Fail-fast: el binario release usa panic=abort; systemd reinicia y el libro se reconstruye desde snapshot.
TimeoutStopSec=10
LimitNOFILE=65536

# Endurecimiento
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
